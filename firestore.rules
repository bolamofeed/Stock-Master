rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions for zero-trust RBAC
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserRole() {
      return request.auth.token.role;
    }

    function isAdmin() {
      return isAuthenticated() && getUserRole() == 'admin';
    }

    function isManager() {
      return isAuthenticated() && (getUserRole() == 'manager' || isAdmin());
    }

    function isCashier() {
      return isAuthenticated() && getUserRole() == 'cashier';
    }

    function isVendor() {
      return isAuthenticated() && getUserRole() == 'vendor';
    }

    function isViewer() {
      return isAuthenticated() && getUserRole() == 'viewer';
    }

    // 1. Items Collection (Catalog)
    match /items/{itemId} {
      allow read: if isAuthenticated() && (
        !isVendor() ||
        resource.data.cid == request.auth.token.allowedCategoryId
      );

      // Writes restricted to Admin and Manager with schema and bounds validation
      allow create, update: if isManager()
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 2
        && request.resource.data.n.size() <= 80
        && request.resource.data.nl is string
        && request.resource.data.cid is string
        && request.resource.data.tq is int
        && request.resource.data.tq >= 0
        && request.resource.data.ls is bool
        && request.resource.data.b is list
        && request.resource.data.b.size() <= 30
        && (!('ca' in resource.data) || request.resource.data.ca == resource.data.ca);

      allow delete: if isAdmin();
    }

    // 2. Item Costs Collection (Isolated data-level security - costs hidden from Cashier/Vendor)
    match /itemCosts/{itemId} {
      allow read: if isManager();
      allow write: if isManager()
        && request.resource.data.b is list
        && request.resource.data.b.size() <= 30;
      allow delete: if isAdmin();
    }

    // 3. Invoices Collection
    match /invoices/{invoiceId} {
      allow read: if isAuthenticated() && (
        isManager() ||
        (isCashier() && resource.data.cb == request.auth.uid) ||
        (isVendor() && resource.data.eid == request.auth.token.supplierId)
      );

      allow create: if (isManager() || isCashier())
        && request.resource.data.no is string
        && request.resource.data.t is int
        && request.resource.data.t in [1, 2, 3]
        && request.resource.data.s is int
        && request.resource.data.s in [1, 2, 3]
        && request.resource.data.tot is int
        && request.resource.data.tot >= 0
        && request.resource.data.l is list
        && request.resource.data.l.size() > 0
        && request.resource.data.l.size() <= 100
        && request.resource.data.cb == request.auth.uid;

      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // 4. Customers Collection
    match /customers/{customerId} {
      allow read: if isAuthenticated() && !isVendor();
      allow create: if (isManager() || isCashier())
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 2
        && request.resource.data.n.size() <= 80
        && request.resource.data.p is string
        && request.resource.data.p.size() >= 8
        && request.resource.data.p.size() <= 20
        && request.resource.data.tp is int
        && request.resource.data.tp >= 0
        && request.resource.data.ic is int
        && request.resource.data.ic >= 0;

      allow update: if isManager();
      allow delete: if isAdmin();
    }

    // 5. Suppliers Collection
    match /suppliers/{supplierId} {
      allow read: if isAuthenticated() && (
        isManager() ||
        (isVendor() && supplierId == request.auth.token.supplierId)
      );
      allow write: if isManager()
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 2
        && request.resource.data.n.size() <= 80;
      allow delete: if isAdmin();
    }

    // 6. Categories Collection
    match /categories/{categoryId} {
      allow read: if isAuthenticated();
      allow write: if isManager()
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 2
        && request.resource.data.n.size() <= 50;
      allow delete: if isManager();
    }

    // 7. Brands Collection (Catalog metadata - Cashier & Viewer can select, Vendor limited to own items)
    match /brands/{brandId} {
      allow read: if isAuthenticated() && (
        !isVendor() ||
        request.auth.token.allowedBrandIds == null ||
        brandId in request.auth.token.allowedBrandIds
      );
      // Admin and Manager can add, edit, and deactivate brands
      allow create, update: if isManager()
        && request.resource.data.n is string
        && request.resource.data.n.size() >= 2
        && request.resource.data.n.size() <= 50
        && request.resource.data.nl is string
        && request.resource.data.sp is int
        && request.resource.data.sp >= 0
        && request.resource.data.st in [0, 1];
      // Block hard deletion when brand is used by items (itemCount > 0)
      allow delete: if isAdmin() && (!('itemCount' in resource.data) || resource.data.itemCount == 0);
    }

    // 8. Brand Costs Collection (Isolated at data level - cost prices strictly hidden from Cashier and Vendor)
    match /brandCosts/{brandId} {
      allow read: if isManager();
      allow write: if isManager()
        && request.resource.data.cp is int
        && request.resource.data.cp >= 0;
      allow delete: if isAdmin();
    }

    // 7. Stats Singleton Summary
    match /stats/summary {
      allow read: if isAuthenticated();
      allow write: if isManager();
    }

    // 8. Users Collection
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isManager());
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 9. Audit Logs (Strictly Immutable, append-only)
    match /auditLogs/{logId} {
      allow read: if isManager();
      allow create: if isAuthenticated()
        && request.resource.data.act is string
        && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // 10. Notifications
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isManager();
    }

    // Default deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
